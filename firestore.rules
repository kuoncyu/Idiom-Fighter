rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 黑名單：只有管理員可以新增／移除；玩家只能讀自己的那一筆（登入時用來判斷是否被停權）
    match /banned/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    function notBanned() { return !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }

    // 管理員名單：只能在 Firebase 後台手動新增，玩家端不可寫入
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 玩家資料（排行榜需要讀取名稱與統計）
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && ((request.auth.uid == uid && notBanned()) || isAdmin());
      match /friends/{fid} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /invites/{code} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      }
    }

    // 好友邀請
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // 大廳聊天
    match /lobbyChat/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.text.size() <= 200;
    }

    // 好友私訊（文件 ID = 兩位玩家 uid 排序後用底線相連；管理員可讀）
    match /dms/{dmId} {
      allow read: if signedIn() && (request.auth.uid in dmId.split('_') || isAdmin());
      allow create, update: if signedIn() && request.auth.uid in dmId.split('_');
      match /messages/{mid} {
        allow read: if signedIn() && (request.auth.uid in dmId.split('_') || isAdmin());
        allow create: if signedIn() && request.auth.uid in dmId.split('_')
                      && request.resource.data.uid == request.auth.uid && request.resource.data.text.size() <= 200;
      }
    }

    // 群組聊天（成員與管理員可讀）
    match /groups/{gid} {
      allow read: if signedIn() && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update, delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /messages/{mid} {
        allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members || isAdmin());
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members
                      && request.resource.data.uid == request.auth.uid && request.resource.data.text.size() <= 200;
      }
    }

    // PK 房間（簡化規則：登入者即可讀寫；正式上線可再收緊）
    match /rooms/{code} {
      allow read, create, update, delete: if signedIn();
      match /events/{eid} { allow read, create: if signedIn(); }
    }
  }
}
